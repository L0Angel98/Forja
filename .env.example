# Copia este archivo a .env y completa los valores antes de `docker compose up`.

# Postgres (compartido por server, ingest y las migraciones)
POSTGRES_USER=forja
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=forja
DATABASE_URL=postgres://forja:cambia-esta-contrasena@postgres:5432/forja

# Puerto HTTP interno del servidor (Caddy lo expone hacia afuera)
PORT=3000

# Dominio servido por Caddy (usa localhost para desarrollo local)
FORJA_DOMAIN=localhost

# Broker MQTT de ingesta de sensores (spec 15)
MQTT_PORT=1883
# Credenciales por gateway: JSON { "usuario": "password", ... }. Sin definir,
# el broker acepta conexiones sin autenticación (solo para desarrollo local).
# MQTT_DEVICE_CREDENTIALS={"gateway-planta-1":"cambia-esta-contrasena"}
