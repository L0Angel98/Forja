{
  "name": "@forja/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "eval:fallas": "tsx scripts/eval-crear-reporte-falla.ts",
    "eval:documentos": "tsx scripts/eval-buscar-documentos.ts",
    "eval:sensores": "tsx scripts/eval-consultar-sensores.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/openai": "^1.3.24",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.0",
    "@forja/core": "workspace:*",
    "@forja/db": "workspace:*",
    "@forja/llm": "workspace:*",
    "@forja/rag": "workspace:*",
    "@forja/runtime": "workspace:*",
    "@forja/shared": "workspace:*",
    "@forja/tools": "workspace:*",
    "fastify": "^5.2.1",
    "pg-boss": "^10.1.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
